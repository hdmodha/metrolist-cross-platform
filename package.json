{
  "name": "metrolist",
  "productName": "Metrolist",
  "private": true,
  "version": "1.1.0",
  "description": "Ad-free, Spotify-style music player for macOS, Windows, Android, iOS and the web, powered by YouTube Music.",
  "author": "Metrolist contributors",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && npm run build:server",
    "build:server": "node scripts/build-node.mjs server",
    "build:electron": "node scripts/build-node.mjs electron",
    "start": "node dist-server/server.mjs",
    "preview": "vite preview",
    "clean": "rm -rf dist dist-server dist-electron release",
    "lint": "tsc --noEmit",
    "adblock:rules": "tsx scripts/generate-ad-block-rules.ts",
    "test": "tsx --test \"src/**/*.test.ts\" \"electron/**/*.test.ts\" \"native/*/src/**/*.test.ts\"",
    "test:e2e": "playwright test",
    "test:electron": "npm run build && npm run build:electron && playwright test -c playwright.electron.config.ts",
    "desktop:dev": "npm run build:electron && electron . --metrolist-dev",
    "desktop:pack": "npm run build && npm run build:electron && electron-builder --dir --publish never",
    "desktop:dist": "npm run build && npm run build:electron && electron-builder --publish never"
  },
  "devDependencies": {
    "@metrolist/capacitor-background-playback": "file:native/capacitor-background-playback",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": ">=4.1.0",
    "@types/express": ">=4.17.21",
    "@types/node": ">=22.0.0",
    "@types/react": ">=19.0.0",
    "@types/react-dom": ">=19.0.0",
    "@vitejs/plugin-react": ">=4.4.0",
    "electron": "45.1.0",
    "electron-builder": "26.18.1",
    "esbuild": ">=0.25.0",
    "express": ">=4.21.2",
    "express-rate-limit": "^8.7.4",
    "lucide-react": ">=0.460.0",
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0",
    "tailwindcss": ">=4.1.0",
    "tsx": ">=4.19.0",
    "typescript": ">=5.7.0",
    "vite": ">=6.4.6"
  },
  "overrides": {
    "path-to-regexp": ">=0.1.12",
    "cookie": ">=0.7.2",
    "send": ">=0.19.2",
    "serve-static": ">=1.16.3",
    "body-parser": ">=1.20.3",
    "ms": ">=2.1.3",
    "debug": ">=4.4.0",
    "nanoid": ">=3.3.8",
    "micromatch": ">=4.0.8",
    "rollup": ">=4.24.0",
    "app-builder-lib": {
      "minimatch@^10.2.5": "11.0.1"
    },
    "@electron/universal": {
      "minimatch@^9.0.3": "11.0.1"
    },
    "@isaacs/nonrecursive-glob-match": "1.0.1"
  }
}
