<?xml version="1.0" encoding="utf-8"?>
<!--
  Merged into the app's manifest by `npx cap sync` (the plugin is a Gradle module of the app).
  Background play: a mediaPlayback foreground service with a media notification, locks while playing.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application>
        <service
            android:name="com.metrolist.backgroundplayback.MediaPlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <receiver
            android:name="com.metrolist.backgroundplayback.PlaybackActionReceiver"
            android:exported="false" />
    </application>
</manifest>
